#!/usr/bin/env zsh
# One entry point for the maintain/ scripts. install/40-cli.zsh symlinks this into ~/.local/bin;
# ${0:A} resolves the symlink so the scripts are found relative to the repo.
set -u
M="${0:A:h}/../maintain"
usage() {
	cat <<USAGE
usage: arch-slate-bridge <command> [args]

  hub [args]       start the Complete Access Hub under Wine (args go to the Hub)
  sync             bridge plugins installed by the Hub into ~/.vst3; run after every install
  doctor           check every piece: PACE service, Hub patch, yabridge, bridged plugins, REAPER cache
  repatch          re-apply the Hub patch after the Hub updated itself (Install button dead again)
  update-yabridge  rebuild yabridge + yabridgectl from master (after a Wine upgrade)
  help             this text

Logs: $(cd "$M/.." && pwd)/cah-wine.log
USAGE
}
cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
hub) exec "$M/start-hub.zsh" "$@" ;;
sync) exec "$M/sync-plugins.zsh" "$@" ;;
doctor) exec "$M/doctor.zsh" "$@" ;;
repatch) exec "$M/repatch-hub.zsh" "$@" ;;
update-yabridge) exec "$M/update-yabridge.zsh" "$@" ;;
help | -h | --help) usage ;;
*)
	print -u2 "arch-slate-bridge: unknown command '$cmd'"
	usage >&2
	exit 2
	;;
esac
